modules = ["python-base-3.13"]

[[ports]]
localPort = 8080
externalPort = 80
# Anikku investigation log
# Updated: 2026-08-17 (Asia/Dhaka)
#
# Baseline comparison:
# - Fork: shan-test-project/ankku1 @ 838227603324a7c5f95d39d6c545e12527cb158b
# - Original Anikku: komikku-app/anikku @ 7ebdc04d97ea40bc5aec4c27d23caaa14870c247
# - The two repositories have the same anime edit/tracker/feed-domain foundations at
#   these heads. Current Anikku master does not contain executable Recommendation or
#   Feed UI implementations.
#
# Confirmed implementation sources:
# - Fill-from-tracker: TachiyomiSY/Komikku EditMangaDialog.kt and
#   edit_manga_dialog.xml (autofill_from_tracker plus tracker selection/lookup handler).
# - Recommendations: TachiyomiSY/Komikku exh/recs/** and the manga detail
#   presentation/navigation wiring.
# - Feed: TachiyomiSY/Komikku ui/browse/feed/**, presentation/browse/FeedScreen.kt,
#   and the browse tab wiring. Anikku only retained the feed saved-search data/domain
#   layer and translated strings.
#
# Root cause:
# - These features were only partially ported from the SY/manga codebase to Anikku's
#   anime codebase. Resource strings and R8 keep rules survived, but no executable UI
#   classes/handlers existed for R8 to retain. R8 is not the cause of the absence.
# - AniList and the other anime tracker login classes are present in source, including
#   TrackLoginActivity's anilist-auth deep link. Keep this flow while porting UI.
#
# Applied safe fixes:
# - Edit Anime Info now exposes autofill_from_tracker and uses linked tracker entries,
#   remote-ID matching, and tracker search metadata to fill title, cover URL, and
#   description. Multiple linked trackers get a selection dialog.
# - Feed now has a Browse tab with latest/popular source entry points and global saved
#   searches backed by the existing FeedSavedSearch interactors.
# - Anime detail now exposes See Recommendations, source related-anime results, and
#   AniList/MAL community recommendation links from linked tracker IDs.
# - build_v7a.yml now builds arm64-v8a preview with R8/resource shrinking and debug
#   signing only; Spotless runs before assemblePreview.
# - Source commit: pending
#
# Remaining: GitHub Actions arm64 compile/build verification and on-device verification
# of autofill, Feed paging, recommendation source callbacks, custom-cover persistence,
# and AniList OAuth. No new keep rules were added for missing classes.
#
# Verification:
# - git diff --check passed.
# - Spotless completed locally.
# - Local Kotlin compile is blocked by the missing Android SDK; GitHub Actions provides
#   the SDK/JDK and is the authoritative APK build check.
# - Actions run: pending
